VITE_CHECKOUT_API=/api/checkout

# Database - pick one:
# 1) Docker (npm run db:dev):  http://127.0.0.1:8080
# 2) Turso cloud:             libsql://your-db-org.turso.io
# 3) turso dev (CLI):         http://127.0.0.1:8080
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# Payment mode: test | production (overrides Admin setting)
# PAYMENT_MODE=test

# Payment providers (configure via Admin > Payment Methods, or fallback env):
# Each provider supports separate test and production credentials.
# STRIPE_SECRET_KEY (fallback when not configured in Admin)
# ADYEN_API_KEY, ADYEN_MERCHANT_ACCOUNT
# PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET
# etc.
